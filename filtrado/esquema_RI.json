{
  "title": "Entradas do dicionario",
  "description": "Representación intermedia dos contidos do dicionario Baía",
  "$defs": {
    "info": {
      "type": "object",
      "required": [
          "definición",
          "termo",
          "clase",
          "xénero",
          "número",
          "forma",
          "abreviación",
          "símbolo",
          "sinónimos",
          "fontes"
      ],
      "additionalProperties": false,
      "properties": {
        "termo"       : { "type": "string" },
        "definición"  : { "type": "string", "pattern": "^.*$" },
        "clase"       : { "enum": [ "substantivo", "adxectivo", "verbo", "frase sustantiva", "" ] },
        "xénero"      : { "enum": [ "masculino", "feminino", "" ] },
        "número"      : { "enum": [ "singular", "plural", "" ] },
        "forma"       : { "enum": [ "principal", "variante", "rexeitada", "" ] },
        "abreviación" : { "type": "string" },
        "símbolo"     : { "type": "string" },
        "sinónimos"   : { "type": "array", "items": { "type": "string", "pattern": "^.+$" } },
        "fontes"      : { "type": "array", "items": { "type": "string", "pattern": "^.+$" } }
      }
    }
  },
  "type": "array",
  "uniqueItems": true,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "patternProperties": {
      "termo" : {
        "type" : "string",
        "pattern" : "^.+$"
      },
      "acepcións": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [ "lingua", "palabras relacionadas", "áreas" ],
          "properties": {
            "lingua": {
              "type": "object",
              "required": [ "gl" ],
              "additionalProperties": false,
              "properties": {
                "gl": { "type": "object", "$ref": "#/$defs/info" },
                "en": { "type": "object", "$ref": "#/$defs/info" },
                "es": { "type": "object", "$ref": "#/$defs/info" }
              }
            },
            "palabras relacionadas": { "type": "array", "items": { "type": "string" } },
            "áreas": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
