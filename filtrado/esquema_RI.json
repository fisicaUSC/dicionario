{
  "title": "Entradas do dicionario",
  "description": "Representación intermedia dos contidos do dicionario Baía",
  "$defs": {
    "info": {
      "type": "object",
      "required": [ "definición", "abreviación", "clase", "fontes", "forma", "número", "sinónimos", "símbolo", "termo", "xénero" ],
      "additionalProperties": false,
      "properties": {
        "termo"       : { "type": "string" },
        "definición"  : { "type": "string", "pattern": "^.*$" },
        "clase"       : { "enum": [ "substantivo", "adxectivo", "verbo", "frase sustantiva", "" ] },
        "xénero"      : { "enum": [ "masculino", "feminino", "" ] },
        "número"      : { "enum": [ "singular", "plural", "" ] },
        "forma"       : { "enum": [ "principal", "variante", "rexeitada", "" ] },
        "abreviación" : { "type": "string" },
        "símbolo"     : { "type": "string" },
        "sinónimos"   : { "type": "array", "items": { "type": "string", "pattern": "^.+$" } },
        "fontes"      : { "type": "array", "items": { "type": "string", "pattern": "^.+$" } }
      }
    }
  },
  "type": "array",
  "uniqueItems": true,
  "items": {
    "type": "object",
    "maxProperties": 1,
    "minProperties": 1,
    "additionalProperties": false,
    "patternProperties": {
      "^.+$": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [ "lingua", "palabras relacionadas", "áreas", "figuras", "ecuacións", "modificado" ],
          "properties": {
            "lingua": {
              "type": "object",
              "required": [ "gl", "en", "es" ],
              "additionalProperties": false,
              "properties": {
                "gl": { "type": "object", "$ref": "#/$defs/info" },
                "en": { "type": "object", "$ref": "#/$defs/info" },
                "es": { "type": "object", "$ref": "#/$defs/info" }
              }
            },
            "palabras relacionadas": { "type": "array", "items": { "type": "string" } },
            "áreas": { "type": "array", "items": { "type": "string" } },
            "figuras": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [ "ruta", "pe" ],
                "additionalProperties": false,
                "properties": {
                  "ruta": { "type": "string" },
                  "pe": { "type": "string" }
                }
              }
            },
            "ecuacións": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [ "ruta", "pe" ],
                "additionalProperties": false,
                "properties": {
                  "ruta": { "type": "string" },
                  "pe": { "type": "string" }
                }
              }
            },
            "modificado": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-2][0-9]:[0-5][0-9]:[0-5][0-9]$"
            }
          }
        }
      }
    }
  }
}
