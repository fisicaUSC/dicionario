{
  "title": "Entradas do dicionario",
  "description": "Contidos do dicionario",
  "$defs": {
    "info": {
      "type": "object",
      "required": [
          "definicion",
          "termo",
          "clase",
          "xenero",
          "numero",
          "forma",
          "abreviacion",
          "simbolo",
          "sinonimos",
          "fontes"
      ],
      "additionalProperties": false,
      "properties": {
        "termo"       : { "type": "string" },
        "definicion"  : { "type": "string", "pattern": "^.*$" },
        "clase"       : { "enum": [ "substantivo", "adxectivo", "verbo", "frase sustantiva", "" ] },
        "xenero"      : { "enum": [ "masculino", "feminino", "" ] },
        "numero"      : { "enum": [ "singular", "plural", "" ] },
        "forma"       : { "enum": [ "principal", "variante", "rexeitada", "" ] },
        "abreviacion" : { "type": "string" },
        "simbolo"     : { "type": "string" },
        "sinonimos"   : { "type": "array", "items": { "type": "string", "pattern": "^.+$" } },
        "fontes"      : { "type": "array", "items": { "type": "string", "pattern": "^.+$" } }
      }
    }
  },
  "type": "array",
  "uniqueItems": true,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required" : ["termo", "acepcions", "relacionadas"],
    "properties": {
      "termo" : {
        "type" : "string",
        "pattern" : "^.+$"
      },
      "acepcions": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [ "lingua" ],
          "properties": {
            "lingua": {
              "type": "object",
              "required": [ "gl" ],
              "additionalProperties": false,
              "properties": {
                "gl": { "type": "object", "$ref": "#/$defs/info" },
                "en": { "type": "object", "$ref": "#/$defs/info" },
                "es": { "type": "object", "$ref": "#/$defs/info" }
              }
            },
            "areas": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "relacionadas": { "type": "array", "items": { "type": "string" } }
    }
  }
}
